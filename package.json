{
  "name": "sascha-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve --configuration=development",
    "start:prod": "ng serve --configuration=production",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "start-debugable-brave": "/usr/bin/flatpak run com.brave.Browser --remote-debugging-port=9222 --user-data-dir=\"~/tmp\" http://localhost:4200",
    "build:testing": "podman image build --build-arg ENVIRONMENT=testing -t registry.zehringer.me/sascha_frontend:testing -f container/Containerfile .",
    "build:staging": "podman image build --build-arg ENVIRONMENT=staging -t registry.zehringer.me/sascha_frontend:staging -f container/Containerfile .",
    "build:production": "podman image build --build-arg ENVIRONMENT=production -t registry.zehringer.me/sascha_frontend:production -f container/Containerfile . && podman image build --build-arg ENVIRONMENT=production -t registry.zehringer.me/sascha_frontend:latest -f container/Containerfile .",
    "push:testing": "podman push registry.zehringer.me/sascha_frontend:testing",
    "push:staging": "podman push registry.zehringer.me/sascha_frontend:staging",
    "push:production": "podman push registry.zehringer.me/sascha_frontend:production && podman push registry.zehringer.me/sascha_backend:latest",
    "build-push:testing": "npm run build:testing && npm run push:testing",
    "build-push:staging": "npm run build:staging && npm run push:staging",
    "build-push:production": "npm run build:production && npm run push:production"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.1",
    "@angular/build": "^20.0.1",
    "@angular/cli": "^20.0.1",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.0.0",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^24.10.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.33.1",
    "@types/bun": "latest"
  }
}
